# Listen on localhost by default. Put the service behind TLS before exposing it.
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://nio_swap_history:change-me@127.0.0.1:5432/nio_swap_history
POLL_INTERVAL_SECONDS=60
# Vehicle state is polled faster while unlocked, and less often while locked.
VEHICLE_UNLOCKED_POLL_INTERVAL_SECONDS=3
VEHICLE_LOCKED_POLL_INTERVAL_SECONDS=20
# Daily recent-100-km energy calculation time in Asia/Shanghai (HH:MM).
NIO_TRIP_ENERGY_TIME=03:00
# Continue station snapshots for this many vehicle polling cycles after swapping ends.
POST_SWAP_POLL_COUNT=60
# Poll the account-scoped service-order endpoint for active orders.
SERVICE_ORDER_POLL_INTERVAL_SECONDS=15
MATCH_WINDOW_SECONDS=1800
RUST_LOG=nio_swap_history_backend=info,actix_web=info

# Optional shared secret for POST /api/v1/poll and /api/v1/orders/import.
# Required automatically when BIND_ADDR is not loopback.
API_KEY=replace-with-a-long-random-value
# To load tenant-scoped API keys and NIO credentials from PostgreSQL, keep only
# this random 64-hex-character master key outside the database after import.
# NIO_CONFIG_MASTER_KEY=

# Optional ChatGPT MCP OAuth. Both values must be configured together.
# Set issuer to the public HTTPS origin served by your reverse proxy.
# Keep the independent login secret private; never put it in a URL or commit it.
# MCP_OAUTH_ISSUER=https://mcp.example.com
# MCP_OAUTH_LOGIN_SECRET=replace-with-another-32-plus-byte-random-value

# Copy the selected station request URL and headers here at deployment time.
# Never commit a real bearer token.
STATION_KEY=my-station
STATION_NAME=常用换电站
STATION_URL=https://app.nio.com/nio/app/bff/map/resources/v1/swap/...
STATION_HEADERS_JSON={"Authorization":"Bearer replace-me"}

# Optional NIO vehicle/widget access. Configure all three sensitive values together.
# API_KEY plus a 32-hex-character NIO_DEVICE_ID also enables SMS login without a vehicle token.
# Keep real values only in the gitignored .env file or a deployment secret manager.
NIO_BEARER_TOKEN=replace-me
# Optional; set only if the upstream journey-detail endpoint requires it.
NIO_ACCOUNT_ID=
NIO_VEHICLE_ID=replace-me
NIO_DEVICE_ID=replace-me
NIO_APP_ID=10002
NIO_APP_VERSION=6.9.0
NIO_REGION=cn
NIO_LANGUAGE=zh-CN
# Optional VIN makes account service-order filtering stricter when vinCode is present.
NIO_VEHICLE_VIN=

# Real swap ordering reuses NIO_CONTROL_API_KEY and the
# X-Vehicle-Control-Key header. Vehicle/order attributes are server-side so
# the client only supplies station ID plus confirmation CREATE SWAP ORDER.
NIO_SWAP_MODEL_TYPE=ET5T
# model_type_year is fixed to G1.2 in swap-order requests.
NIO_SWAP_TARGET_BATTERY_CAP_LEVEL=1

# Optional vehicle-control API. Disabled unless a separate 32+ character key
# and all three absolute credential paths are configured. Do not copy the
# local Python client's keys into this project or commit any credentials.
# The TLS private key must be owner-only (chmod 600). The server CA bundle is
# the authorized trust_chain.pem; the pinned icar leaf is also checked.
# NIO_CONTROL_API_KEY=
# Reusing API_KEY for vehicle control broadens that key's authority. Off by default.
# NIO_CONTROL_ALLOW_SHARED_API_KEY=false
# NIO_CONTROL_TLS_CERT_PATH=/absolute/path/tls-certificate.pem
# NIO_CONTROL_TLS_KEY_PATH=/absolute/path/tls-private-key.pem
# NIO_CONTROL_CA_PATH=/absolute/path/trust_chain.pem
# Optional for PIN-protected unlock actions and the manual TLS certificate
# issuer. Point to an existing owner-only (0600) file containing only
# NIO_VEHICLE_ID=... and PIN=...; never put the PIN in an HTTP request.
# NIO_CONTROL_PIN_FILE=/absolute/path/owner-only/pin.env
# Only for optional compose.control.yaml: absolute paths on the Docker host.
# These are mount sources, not paths inside the container. The files must
# remain private and readable by the container's UID 10001.
# NIO_CONTROL_TLS_CERT_HOST_PATH=/absolute/host/path/tls-certificate.pem
# NIO_CONTROL_TLS_KEY_HOST_PATH=/absolute/host/path/tls-private-key.pem
# NIO_CONTROL_CA_HOST_PATH=/absolute/host/path/trust_chain.pem
# NIO_CONTROL_PIN_HOST_PATH=/absolute/host/path/pin.env

# Optional generic service-order integration. The backend forces the swap-order
# type and issues separate active/history queries against this URL.
# NIO-Dash-compatible aliases NIO_CHANGE_API_URL / NIO_CHANGE_ACCESS_TOKEN /
# NIO_CHANGE_API_HEADERS / NIO_CHANGE_COOKIE are also accepted.
SERVICE_ORDER_URL=https://gateway-front-external.nio.com/moat/1100367/api/v1/otd/car/ext/general/serviceOrder/getTabOrder?offset=0&limit=2000
SERVICE_ORDER_ACCESS_TOKEN=replace-me
SERVICE_ORDER_HEADERS_JSON={}
SERVICE_ORDER_COOKIE=

# When an active order contains a PS-NIO-* station ID, replace {station_id}
# and fetch that target station immediately. Other placeholders are filled
# from the NIO vehicle configuration above.
STATION_URL_TEMPLATE=https://app.nio.com/nio/app/bff/map/resources/v1/swap/{station_id}?region={region}&vehicle_id={vehicle_id}&device_id={device_id}&lang=zh_cn&app_ver={app_version}&app_id={app_id}
STATION_TEMPLATE_HEADERS_JSON={}
